{
  "branches": [
    "main"
  ],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          {
            "breaking": true,
            "release": "major"
          },
          {
            "revert": true,
            "release": "patch"
          },
          {
            "type": "feat",
            "release": "minor"
          },
          {
            "type": "fix",
            "release": "patch"
          },
          {
            "type": "perf",
            "release": "patch"
          },
          {
            "type": "refactor",
            "release": "patch"
          },
          {
            "type": "docs",
            "release": false
          },
          {
            "type": "style",
            "release": false
          },
          {
            "type": "test",
            "release": false
          },
          {
            "type": "build",
            "release": false
          },
          {
            "type": "ci",
            "release": false
          },
          {
            "type": "chore",
            "release": false
          }
        ],
        "parserOpts": {
          "noteKeywords": [
            "BREAKING CHANGE",
            "BREAKING CHANGES"
          ]
        }
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "parserOpts": {
          "noteKeywords": [
            "BREAKING CHANGE",
            "BREAKING CHANGES"
          ]
        }
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dist/fd3206-write-unlock-attiny2313a.hex",
            "label": "Firmware for the ATtiny2313A, Intel HEX"
          },
          {
            "path": "dist/fd3206-write-unlock-attiny2313a.hex.sha256",
            "label": "SHA-256 of the ATtiny2313A firmware"
          },
          {
            "path": "dist/fd3206-write-unlock-attiny4313.hex",
            "label": "Firmware for the ATtiny4313, Intel HEX"
          },
          {
            "path": "dist/fd3206-write-unlock-attiny4313.hex.sha256",
            "label": "SHA-256 of the ATtiny4313 firmware"
          },
          {
            "path": "dist/fd3206-write-unlock.sigstore.json",
            "label": "Signed build provenance of both firmware images, Sigstore bundle"
          },
          {
            "path": "dist/fd3206-write-unlock.spdx.json",
            "label": "Software bill of materials, SPDX JSON"
          }
        ],
        "successComment": false,
        "failComment": false,
        "failTitle": false,
        "releasedLabels": false
      }
    ]
  ]
}
