{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "github-actions",
    "asdf",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "ARG DEBIAN_SNAPSHOT=(?<currentValue>\\d{8}T\\d{6}Z)"
      ],
      "depNameTemplate": "debian-snapshot",
      "datasourceTemplate": "custom.debian-snapshot",
      "versioningTemplate": "regex:^(?<major>\\d{8})T(?<minor>\\d{6})Z$"
    }
  ],
  "customDatasources": {
    "debian-snapshot": {
      "defaultRegistryUrlTemplate": "https://snapshot.debian.org/mr/timestamp/?archive=debian&after=2026-10-01",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": result.debian.{\"version\": $}}"
      ]
    }
  },
  "dependencyDashboard": false,
  "schedule": [
    "before 6am on monday"
  ],
  "timezone": "Etc/UTC",
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "github-runner"
      ],
      "enabled": true,
      "semanticCommitType": "ci"
    },
    {
      "matchManagers": [
        "asdf"
      ],
      "matchPackageNames": [
        "python"
      ],
      "allowedVersions": "<3.14"
    },
    {
      "matchDatasources": [
        "custom.debian-snapshot"
      ],
      "semanticCommitType": "build"
    }
  ]
}
